executable = /home/adiaz/Cascades/th34/do_fit.sh
log =    /scratch/adiaz/th34/fit/logs/$(ClusterID).out
output = /scratch/adiaz/th34/fit/logs/$(ClusterID).stdout
error =  /scratch/adiaz/th34/fit/logs/$(ClusterID).stderr
should_transfer_files   = YES
transfer_output_files = ""
environment = "POINT=$(point) FLUXDIR=$(fluxdir) OUTDIR=$(outdir)"
arguments = "--point $(point) --use_fastMC $(use_fastMC) --Emax $(Emax) --sim $(sim) --max_sim $(max_sim) --fast_scaling $(fast_scaling) --realization_file $(realization_file) --outdir $(outdir) $(tau_neutrinos) --fastmc_dir $(fastmc_dir) --n_seeds $(n_seeds) --years $(years)"
stream_output = True
request_memory = 3G
#+AccountingGroup="quicktest.$ENV(USER)"

queue
