executable = /home/adiaz/Cascades/th34/do_fit_OSG.sh

use_x509userproxy = true   
#+WantGlidein = True
x509userproxy = /tmp/x509up_u19015
Requirements = HAS_CVMFS_icecube_opensciencegrid_org  && (GLIDEIN_Site =!= "Nebraska") && (GLIDEIN_Site =!= "ComputeCanada-Cedar")
#Requirements = HAS_CVMFS_icecube_opensciencegrid_org =?= True && OpSysLongName =!= "Debian GNU/Linux 7" && OpSysLongName =!= "Ubuntu 15.10" && OpSysName =!= "Ubuntu"  && GLIDEIN_ResourceName =!= "UCSDT2" && GLIDEIN_Site =!= "PSU" && OpSysMajorVer =!= 6

log =    /scratch/adiaz/th34/fit/logs/$(ClusterID).out
output = /scratch/adiaz/th34/fit/logs/$(ClusterID).stdout
error =  /scratch/adiaz/th34/fit/logs/$(ClusterID).stderr
should_transfer_files   = YES
transfer_input_files = /home/adiaz/MEOWS/Analysis/scripts/jobs/Brazil.py
transfer_output_files = ""
environment = "POINT=$(point)"
arguments = "--point $(point) --use_fastMC $(use_fastMC) --Emax $(Emax) --sim $(sim) --max_sim $(max_sim) --fast_scaling $(fast_scaling) --realization_file $(realization_file) --outdir $(outdir) $(tau_neutrinos) --fastmc_dir $(fastmc_dir) --n_seeds $(n_seeds) --osg $(osg) --fluxdir $(fluxdir) --years $(years)"
stream_output = True
request_memory = 3G
#+AccountingGroup="quicktest.$ENV(USER)"
#
+OriginalTime = 36000
periodic_hold = (JobStatus == 2) && (time() - EnteredCurrentStatus) > (8 * 3600)
periodic_hold_reason = "Job ran for more than eight hours"
periodic_hold_subcode = 1
periodic_release = (HoldReasonSubCode == 1)

queue
