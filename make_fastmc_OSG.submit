executable = /home/adiaz/Cascades/th34/make_fastmc_OSG.sh

use_x509userproxy = true   
#+WantGlidein = True
x509userproxy = /tmp/x509up_u19015
Requirements = HAS_CVMFS_icecube_opensciencegrid_org
#Requirements = HAS_CVMFS_icecube_opensciencegrid_org =?= True && OpSysLongName =!= "Debian GNU/Linux 7" && OpSysLongName =!= "Ubuntu 15.10" && OpSysName =!= "Ubuntu"  && GLIDEIN_ResourceName =!= "UCSDT2" && GLIDEIN_Site =!= "PSU" && OpSysMajorVer =!= 6

log =    /scratch/adiaz/th34/fastmc/logs/$(ClusterID).out
output = /scratch/adiaz/th34/fastmc/logs/$(ClusterID).stdout
error =  /scratch/adiaz/th34/fastmc/logs/$(ClusterID).stderr
should_transfer_files   = YES
transfer_output_files = ""
environment = "POINT=$(point) FLUXDIR=$(fluxdir)"
transfer_input_files = /home/adiaz/MEOWS/Analysis/scripts/jobs/Brazil.py
arguments = "--point $(point) --gen_fastMC $(gen_fastMC) --Emax $(Emax) --sim $(sim) --max_sim $(max_sim) --fast_scaling $(fast_scaling) $(tau_neutrinos) --fastmc_dir $(fastmc_dir) --years $(years) --osg $(osg)"
stream_output = True
request_memory = 8G
#+AccountingGroup="quicktest.$ENV(USER)"

queue
