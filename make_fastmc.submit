executable = /data/ana/SterileNeutrino/IC86/HighEnergy/Analysis/th34/code/IC-MEOWS-th34/make_fastmc.sh
log =    /scratch/adiaz/th34/fastmc/logs/$(ClusterID).out
output = /scratch/adiaz/th34/fastmc/logs/$(ClusterID).stdout
error =  /scratch/adiaz/th34/fastmc/logs/$(ClusterID).stderr
should_transfer_files   = YES
transfer_output_files = ""
environment = "POINT=$(point) FLUXDIR=$(fluxdir)"
arguments = "--point $(point) --gen_fastMC $(gen_fastMC) --Emax $(Emax) --sim $(sim) --max_sim $(max_sim) --fast_scaling $(fast_scaling) $(tau_neutrinos) --fastmc_dir $(fastmc_dir) --years $(years)"
stream_output = True
request_memory = 8G
#+AccountingGroup="quicktest.$ENV(USER)"

queue
