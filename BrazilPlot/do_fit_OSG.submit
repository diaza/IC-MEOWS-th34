executable = /home/adiaz/IC-MEOWS-th34/BrazilPlot/do_fit_OSG.sh

use_x509userproxy = true   
#+WantGlidein = True
x509userproxy = /tmp/x509up_u19015
Requirements = HAS_CVMFS_icecube_opensciencegrid_org =?= True  && (GLIDEIN_Site =!= "Nebraska") && (GLIDEIN_Site =!= "ComputeCanada-Cedar") && (GLIDEIN_Site =!= "NotreDame")
#Requirements = HAS_CVMFS_icecube_opensciencegrid_org =?= True  && (GLIDEIN_Site =!= "Nebraska") && (GLIDEIN_Site =!= "ComputeCanada-Cedar")  && (GLIDEIN_Site =!= "Harvard")
#Requirements = HAS_CVMFS_icecube_opensciencegrid_org =?= True && OpSysLongName =!= "Debian GNU/Linux 7" && OpSysLongName =!= "Ubuntu 15.10" && OpSysName =!= "Ubuntu"  && GLIDEIN_ResourceName =!= "UCSDT2" && GLIDEIN_Site =!= "PSU" && OpSysMajorVer =!= 6

log =    /scratch/adiaz/th34/BrazilPlots/logs/$(ClusterID).out
output = /scratch/adiaz/th34/BrazilPlots/logs/$(ClusterID).stdout
error =  /scratch/adiaz/th34/BrazilPlots/logs/$(ClusterID).stderr
should_transfer_files   = YES
transfer_input_files = /home/adiaz/IC-MEOWS-th34/Brazil.py
transfer_output_files = ""
environment = "outdirbase=$(outdir) Ut4sq=$(Ut4sq) SEQ=$(seq)"
arguments = "--point $(point) --use_fastMC $(use_fastMC) --Emax $(Emax) --sim $(sim) --max_sim $(max_sim) --fast_scaling $(fast_scaling) --fastmc_dir $(fastmc_dir) --n_seeds $(n_seeds) --osg $(osg) --fluxdir $(fluxdir) --years $(years) --crSlopeWidth $(crSlopeWidth)"
stream_output = True
request_memory = 3G
#+AccountingGroup="quicktest.$ENV(USER)"
#
+OriginalTime = 14400

queue
