executable = /home/adiaz/IC-MEOWS-th34/BrazilPlot/do_fit.sh
log =    /scratch/adiaz/th34/BrazilPlots/logs/$(ClusterID).out
output = /scratch/adiaz/th34/BrazilPlots/logs/$(ClusterID).stdout
error =  /scratch/adiaz/th34/BrazilPlots/logs/$(ClusterID).stderr
should_transfer_files   = YES
transfer_output_files = ""
environment = "outdirbase=$(outdir) Ut4sq=$(Ut4sq) SEQ=$(seq) POINT=$(point) FLUXDIR=$(fluxdir)"
arguments = "--point $(point) --use_fastMC $(use_fastMC) --Emax $(Emax) --sim $(sim) --max_sim $(max_sim) --fast_scaling $(fast_scaling) --fastmc_dir $(fastmc_dir) --n_seeds $(n_seeds) --years $(years) --crSlopeWidth $(crSlopeWidth)"
stream_output = True
request_memory = 3G
#+AccountingGroup="quicktest.$ENV(USER)"
+OriginalTime = 14400

queue
