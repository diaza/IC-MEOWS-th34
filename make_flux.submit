executable = /data/ana/SterileNeutrino/IC86/HighEnergy/Analysis/th34/code/IC-MEOWS-th34/make_flux.sh
log =    /scratch/adiaz/th34/fluxes/logs/$(ClusterID).out
output = /scratch/adiaz/th34/fluxes/logs/$(ClusterID).stdout
error =  /scratch/adiaz/th34/fluxes/logs/$(ClusterID).stderr
should_transfer_files   = YES
transfer_output_files = ""
environment = "OUTDIR=$(outdir)"
arguments = "--th24 $(th24) --indir $(indir) --outdir $(outdir) --conv_flux $(conv_flux) --prompt_flux $(prompt_flux) --index $(index) --dmsq41 $(dmsq41) --th14 $(th14) --th34 $(th34) --del14 $(del14) --del24 $(del24)"
stream_output = True
request_memory = 3G
#+AccountingGroup="quicktest.$ENV(USER)"

periodic_hold = (JobStatus == 2) && (time() - EnteredCurrentStatus) > (24 * 3600)
periodic_hold_reason = "Job ran for more than 24 hours"
periodic_hold_subcode = 42
periodic_release = (HoldReasonSubCode == 42)

queue
