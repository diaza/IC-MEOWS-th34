executable = /data/ana/SterileNeutrino/IC86/HighEnergy/Analysis/th34/code/IC-MEOWS-th34/make_flux_OSG.sh

use_x509userproxy = true   
#+WantGlidein = True
x509userproxy = /tmp/x509up_u19015
Requirements = HAS_CVMFS_icecube_opensciencegrid_org && (GLIDEIN_Site =!= "Nebraska") && (GLIDEIN_Site =!= "ComputeCanada-Cedar")
#Requirements = HAS_CVMFS_icecube_opensciencegrid_org =?= True && OpSysLongName =!= "Debian GNU/Linux 7" && OpSysLongName =!= "Ubuntu 15.10" && OpSysName =!= "Ubuntu"  && GLIDEIN_ResourceName =!= "UCSDT2" && GLIDEIN_Site =!= "PSU" && OpSysMajorVer =!= 6

log =    /scratch/adiaz/th34/fluxes/logs/$(ClusterID).out
output = /scratch/adiaz/th34/fluxes/logs/$(ClusterID).stdout
error =  /scratch/adiaz/th34/fluxes/logs/$(ClusterID).stderr
should_transfer_files   = YES
transfer_input_files = /data/ana/SterileNeutrino/IC86/HighEnergy/Analysis/th34/code/IC-MEOWS-th34/make_flux_fastmc/Fluxes.py
transfer_output_files = ""
#environment = "OUTDIR=$(outdir)"
arguments = "--th24 $(th24) --indir $(indir) --outdir $(outdir) --conv_flux $(conv_flux) --prompt_flux $(prompt_flux) --index $(index) --dmsq41 $(dmsq41) --th14 $(th14) --th34 $(th34) --del14 $(del14) --del24 $(del24) --osg $(osg)"
stream_output = True
request_memory = 2G
#+AccountingGroup="quicktest.$ENV(USER)"
#
+OriginalTime = 36000
periodic_hold = (JobStatus == 2) && (time() - EnteredCurrentStatus) > (10 * 3600)
periodic_hold_reason = "Job ran for more than ten hours"
periodic_hold_subcode = 1
periodic_release = (HoldReasonSubCode == 1)

queue


